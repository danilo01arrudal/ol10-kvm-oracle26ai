environment = "prd"
vm_config = {
  name          = "ol8-prd"
  memory        = 10240
  vcpus         = 2
  disk_size_gb  = 59
  disk_size_mb  = 60416
  swap_size_mb  = 8192
  ip            = "192.168.122.24"
  gateway       = "192.168.122.1"
  netmask       = "255.255.255.0"
  dns           = "192.168.122.1"
  hostname      = "prd-server"
  iso_path      = "/var/lib/libvirt/images/OracleLinux-R8-U10-x86_64-dvd.iso"
  disk_path     = "/var/lib/libvirt/images/ol8-prd.qcow2"
  network       = "default"
  timezone      = "America/Fortaleza"
  root_password_hash = "$6$def456..."
  user_name     = "admin"
  user_password_hash = "$6$def456..."
}

# ============================================================
# SSH KEY
# ============================================================
ssh_private_key_path = "/root/.ssh/ol8-kvm-terraform"
ssh_public_key_path  = "/root/.ssh/ol8-kvm-terraform.pub"

# ============================================================
# Oracle Database 26ai - Credenciais e parâmetros
# ============================================================
oracle_password_hash = "$6$xyz789..."
sys_password        = "$6$xyz789..."
system_password     = "$6$xyz789..."
pdbadmin_password   = "$6$xyz789..."
dbsnmp_password     = "$6$xyz789..."
db_sid              = "appscdb"
pdb_name            = "appspdb1"
oracle_home_version = "23.26.1"
oracle_software_zip = "V1054592-01.zip"

